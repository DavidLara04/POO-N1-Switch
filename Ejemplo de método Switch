-Ejemplo de método Switch
public class Persona {
    private String genero;

    public Persona(String genero) {
        this.genero = genero;
    }

    public void mostrarGenero() {
        switch (genero.toLowerCase()) {
            case "masculino":
                System.out.println("Es un hombre.");
                break;
            case "femenino":
                System.out.println("Es una mujer.");
                break;
            case "otro":
                System.out.println("Otro género especificado.");
                break;
            default:
                System.out.println("Género no reconocido.");
        }
    }
}

- Uso en el método main
public class Main {
    public static void main(String[] args) {
        Persona persona3 = new Persona("Femenino");
        persona3.mostrarGenero();
    }
}
